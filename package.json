{
  "name": "marktplaats-poster",
  "productName": "Marktplaats Poster",
  "version": "0.1.3",
  "description": "Vult Marktplaats-advertenties in voor telefoonwinkels",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "playwright-core": "^1.48.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "nl.marktplaatsposter.app",
    "productName": "Marktplaats Poster",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**"
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Marktplaats-Poster-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "alireza220",
      "repo": "marktplaats-poster"
    }
  }
}
